# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/upclass?schema=public

# Replace with a long, random secret before running the application
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary credentials from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Backend server settings
PORT=3000
CORS_URL=http://localhost:5000
