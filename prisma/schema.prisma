// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// enum Gendar {
//   MALE
//   FEMALE
// }

enum RoleType {
  SYSTEM_ROLE
  CUSTOM
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model School {
  id                 String              @id @default(cuid())
  name               String
  email              String?
  phone              String?
  address            String?
  logo               String?
  shortCode          String?
  schoolType         SchoolType?
  educationSystem    EducationSystem?
  establishedYear    Int?
  description        String?
  principalName      String?
  vicePrincipalName  String?
  adminContact       String?
  ownerName          String?
  dateFormat         String?
  feeDueDate         Int?
  workingDays        String[]            @default([])
  openingTime        String?
  closingTime        String?
  isActive           Boolean             @default(true)
  users              User[]
  roles              Role[]
  teachers           Teacher[]
  subjects           Subject[]
  classes            Class[]
  sections           Section[]
  periods            Period[]
  timetableEntries   TimetableEntry[]
  students           Student[]
  academicYears      AcademicYear[]
  academicTerms      AcademicTerm[]
  leavePolicies      LeavePolicy[]
  leavePolicySetting LeavePolicySetting?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id        String    @id @default(cuid())
  name      String
  password  String
  email     String    @unique()
  isActive  Boolean   @default(true)
  isSystem  Boolean   @default(false)
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id])
  teachers  Teacher[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  school    School?   @relation(fields: [schoolId], references: [id])
  schoolId  String?
}

model Role {
  id          String           @id @default(cuid())
  name        String
  slug        String
  description String?
  type        RoleType         @default(CUSTOM)
  schoolId    String?
  school      School?          @relation(fields: [schoolId], references: [id])
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([schoolId, slug])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  group       String           @default("System")
  module      String           @default("Unknown")
  action      String           @default("View")
  sortOrder   Int              @default(0)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum SubjectType {
  THEORY
  PRACTICAL
  LAB
  MIXED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum SchoolType {
  PRIVATE
  GOVERNMENT
}

enum EducationSystem {
  MATRIC
  CAMBRIDGE
  FEDERAL
  OTHER
}

model Subject {
  id                  String           @id @default(cuid())
  name                String
  code                String
  schoolId            String
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  type                SubjectType
  status              SubjectStatus    @default(ACTIVE)
  hasPractical        Boolean          @default(false)
  defaultTotalMarks   Float            @default(100)
  defaultPassingMarks Float            @default(33)
  timetableEntries    TimetableEntry[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([schoolId, code])
}

model Documents {
  id           String   @id @default(uuid())
  documentName String?
  documentUrl  String?
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  schoolId         String?
  school           School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  image            String?
  imagePublicId    String?
  firstName        String
  lastName         String?
  dateOfBirth      DateTime?
  gender           Gender?
  cnicNo           String?          @unique
  maritalStatus    MaritalStatus?
  employeeId       String?          @unique
  qualification    String?
  joiningDate      DateTime?
  employmentType   EmploymentType?  @default(FULL_TIME)
  isActive         Boolean?         @default(true)
  phone            String?
  email            String?          @unique
  address          String?
  bankName         String?
  accountNumber    String?
  documents        Documents[]
  classSections    ClassSection[]   @relation("ClassSectionTeacher")
  timetableEntries TimetableEntry[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

enum SectionStatus {
  ACTIVE
  INACTIVE
}

enum PeriodType {
  PERIOD
  BREAK
}

enum PeriodStatus {
  ACTIVE
  INACTIVE
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Section {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name          String
  status        SectionStatus  @default(ACTIVE)
  classSections ClassSection[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([schoolId, name])
}

model Period {
  id               String           @id @default(cuid())
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name             String
  startTime        String
  endTime          String
  type             PeriodType       @default(PERIOD)
  sortOrder        Int
  status           PeriodStatus     @default(ACTIVE)
  timetableEntries TimetableEntry[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, sortOrder])
}

model Class {
  id             String         @id @default(cuid())
  schoolId       String
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name           String
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  status         ClassStatus    @default(ACTIVE)
  students       Student[]
  sections       ClassSection[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([schoolId, name, academicYearId])
  @@index([academicYearId])
}

model ClassSection {
  id               String           @id @default(cuid())
  classId          String
  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId        String
  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  teacherId        String
  teacher          Teacher          @relation("ClassSectionTeacher", fields: [teacherId], references: [id])
  room             String?
  capacity         Int?
  timetableEntries TimetableEntry[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([classId, sectionId])
}

model Student {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         Gender?
  identityNumber String?
  bloodGroup     String?
  classId        String
  class          Class         @relation(fields: [classId], references: [id], onDelete: Restrict)
  roll           String
  admissionDate  DateTime?
  status         StudentStatus @default(ACTIVE)
  guardian       String
  relation       String
  phone          String
  email          String?
  address        String?
  photo          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([schoolId, roll])
  @@index([classId])
}

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model AcademicYear {
  id                String             @id @default(cuid())
  schoolId          String
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  year              String
  startDate         DateTime
  endDate           DateTime
  status            AcademicYearStatus @default(ACTIVE)
  academicYearTerms AcademicYearTerm[]
  classes           Class[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([schoolId, year])
}

model AcademicTerm {
  id                String             @id @default(cuid())
  schoolId          String
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name              String
  academicYearTerms AcademicYearTerm[]
  timetableEntries  TimetableEntry[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([schoolId, name])
}

model AcademicYearTerm {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  academicTermId String
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, academicTermId])
}

model LeavePolicy {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name        String
  daysPerYear Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, name])
}

model LeavePolicySetting {
  id               String   @id @default(cuid())
  schoolId         String   @unique
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  approvalRequired Boolean  @default(true)
  carryForward     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TimetableEntry {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  academicTermId String
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  periodId       String
  period         Period       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  day            WeekDay
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([classSectionId, academicTermId, periodId, day])
  @@unique([teacherId, academicTermId, periodId, day])
  @@index([schoolId])
  @@index([classSectionId])
  @@index([teacherId])
}
